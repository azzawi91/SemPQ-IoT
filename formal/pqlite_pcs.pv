(* PQ-Lite KEM re-key: post-compromise recovery.
   Phase 0: N and G share a session root key RK (established by the handshake, abstracted here)
            and exchange a record.
   Phase 1: the attacker obtains RK and the current chain key (state compromise); the message
            key of the earlier record was deleted.
   Phase 2: re-key. N sends a fresh ML-KEM encapsulation key inside a record; G encapsulates;
            both derive RK' = kdf(RK, ss). N then sends secret2 under the new chain.
   Variant PASSIVE (this file): the re-key messages reach the peer unmodified (the attacker
   observes them but cannot inject during this exchange), the standard condition for healing.
   Variant ACTIVE (generated by make_variants.py): the attacker may replace them; recovery is
   then not expected, which documents the condition. *)

free c: channel.
free cp: channel [private].

type key.
type kemsk.
type kempkey.
type kseed.

fun kempk(kemsk): kempkey.
fun kemct(kempkey, kseed): bitstring.
fun kemss(kempkey, kseed): key.
reduc forall sk: kemsk, r: kseed; kemdec(sk, kemct(kempk(sk), r)) = kemss(kempk(sk), r).

fun kdf(key, key): key.
fun ck0(key): key.
fun mk(key): key.
fun next(key): key.
fun aenc(key, bitstring, bitstring): bitstring.
reduc forall k: key, m: bitstring, ad: bitstring; adec(k, aenc(k, m, ad), ad) = m.
fun ek2bs(kempkey): bitstring [data].

const AD0, AD1, AD2: bitstring [data].
free RK: key [private].
free CK0: key [private].              (* initial chain key from the handshake KDF *)
free secret1: bitstring [private].
free secret2: bitstring [private].

query attacker(secret1) phase 2.       (* record sent before the compromise: forward secrecy *)
query attacker(secret2) phase 2.       (* after compromise and re-key *)

let NodeRekey =
  new dk: kemsk;
  let ek = kempk(dk) in
  out(c, aenc(mk(next(CK0)), ek2bs(ek), AD1));
  out(cp, ek);
  (* PASSIVE: read the peer's response from the authentic copy *)
  in(cp, ct: bitstring);
  let ss = kemdec(dk, ct) in
  let RK2 = kdf(RK, ss) in
  out(c, aenc(mk(ck0(RK2)), secret2, AD2)).

let GatewayRekey =
  in(cp, ek: kempkey);
  new r: kseed;
  let ct = kemct(ek, r) in
  out(c, ct);
  out(cp, ct).

process
  out(c, aenc(mk(CK0), secret1, AD0))
  | (phase 1; out(c, (RK, next(CK0))))   (* state after the first record: root + current chain key *)
  | (phase 2; (NodeRekey | GatewayRekey))
